# Copy this file to .env and fill in your values

# --- Database ---
# Windows local MySQL:
# DATABASE_URL=mysql+pymysql://root:YourPassword@localhost:3306/eap_pms
#
# Ubuntu server MySQL:
# DATABASE_URL=mysql+pymysql://titan_user:YourPassword@localhost:3306/eap_pms

DATABASE_URL=mysql+pymysql://root:YourPassword@localhost:3306/eap_pms

# --- JWT ---
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS (comma-separated origins, or * for open LAN) ---
# CORS_ORIGINS=http://din.eappms,http://localhost:5174
CORS_ORIGINS=*

# --- Platform super-admin (separate URL /platform — NOT customer users) ---
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_PASSWORD=ChangeMe-Platform-2026!
PLATFORM_TOKEN_EXPIRE_HOURS=8

# --- Email (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=your@email.com

# --- Node-RED / SIE EDA (IMM live trx) ---
# Node-RED exposes GET /imm/api/live after importing flows.json
NODE_RED_URL=http://127.0.0.1:1880
# Shared secret for POST /api/imm/nodered/webhook/push (Node-RED → EAP push mode)
# NODE_RED_WEBHOOK_SECRET=change-me
# Shared secret for PATCH /api/machines/{id}/status (falls back to NODE_RED_WEBHOOK_SECRET)
# MACHINE_STATUS_PUSH_SECRET=change-me
