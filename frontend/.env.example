# Copy this file to .env
#
# DEV (recommended): leave VITE_* empty — Vite proxies /api and /ws to the backend.
# Works from localhost and LAN (e.g. http://10.151.47.75:5184).
#
# PRODUCTION build on a server: set your server IP and backend port (8040):
#   VITE_API_URL=http://YOUR_SERVER_IP:8040
#   VITE_WS_URL=ws://YOUR_SERVER_IP:8040

VITE_API_URL=
VITE_WS_URL=

# Branding — default app title when not set in Factory Setup / database
# VITE_APP_NAME=Production Monitoring System (PMS)

# Embed mode — hide navigation when integrated in CPLM or iframe
# VITE_EMBED_INTEGRATION=true
# VITE_HIDE_SHELL_NAV=true

# URL params also work: ?embed=1  ?hideNav=1  ?showNav=1
# Parent frame: postMessage({ type: 'titan-shell-nav', hidden: true })
