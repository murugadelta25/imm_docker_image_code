    {
        "id": "a1b2c3d4e5f60001",
        "type": "function",
        "z": "dcd1ff4abbc62ba8",
        "name": "Route by trx.name",
        "func": "const raw = msg.payload;\nif (!raw || !raw.trx) {\n    return null;\n}\n\nconst trxName = String(raw.trx.name || \"\").trim();\nconst body = raw.trx.body || {};\n\nconst values = {};\nfor (const [k, v] of Object.entries(body)) {\n    if (v === \"true\" || v === \"false\") {\n        values[k] = v === \"true\";\n    } else if (v !== \"\" && v !== null && !isNaN(Number(v))) {\n        values[k] = Number(v);\n    } else {\n        values[k] = v;\n    }\n}\n\nconst normalized = {\n    stream: trxName,\n    device: raw.device,\n    messageId: raw.id,\n    ts: raw.ts,\n    origin: raw.origin,\n    values\n};\n\nconst routeIndex = {\n    \"IMM17\": 0,\n    \"IMM18\": 1,\n    \"PowerFactor\": 2,\n    \"Total_enery_cumulative\": 3,\n    \"EM_Current\": 4,\n    \"EM_Voltage\": 5\n};\n\nlet outIdx = routeIndex[trxName];\n\nif (outIdx === undefined) {\n    if (/^IMM\\d+$/i.test(trxName)) {\n        outIdx = 6;\n        normalized.category = \"machine\";\n        normalized.machineId = trxName.toUpperCase();\n    } else {\n        node.warn(\"Unknown trx.name: \" + trxName);\n        return null;\n    }\n} else if (outIdx <= 1) {\n    normalized.category = \"machine\";\n    normalized.machineId = trxName.toUpperCase();\n} else {\n    normalized.category = \"energy\";\n    const energyMap = {\n        2: \"power_factor\",\n        3: \"total_energy_cumulative\",\n        4: \"em_current\",\n        5: \"em_voltage\"\n    };\n    normalized.energyType = energyMap[outIdx];\n}\n\nif (normalized.category === \"machine\") {\n    const canon = {};\n    for (const [k, v] of Object.entries(values)) {\n        const lk = k.toLowerCase();\n        if (lk.includes(\"heater\")) canon.heater_status = v;\n        else if (lk.includes(\"motor\")) canon.motor_status = v;\n        else if (lk.includes(\"refill\")) canon.refilling = v;\n        else if (lk.includes(\"injection\")) canon.injection_status = v;\n    }\n    normalized.status = canon;\n}\n\nmsg.topic = trxName;\nmsg.payload = normalized;\n\nconst outputs = [null, null, null, null, null, null, null];\noutputs[outIdx] = msg;\nreturn outputs;",
        "outputs": 7,
