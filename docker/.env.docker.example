# Copy to docker/.env.docker and fill values before compose / runtime.

# --- Database ---
# Option A — External MySQL on host / LAN (recommended for production & App Management):
# DATABASE_URL=mysql+pymysql://root:Mysql%402026@host.docker.internal:3306/plastech_solution_imm_pms
# On Ubuntu gateway (MySQL on same host): use host gateway IP or docker bridge gateway, e.g.
# DATABASE_URL=mysql+pymysql://titan_user:YourPassword@10.151.47.6:3306/plastech_solution_imm_pms
#
# Option B — Bundled MySQL via compose profile with-mysql:
DATABASE_URL=mysql+pymysql://imm:imm_secret@mysql:3306/plastech_solution_imm_pms
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_PASSWORD=imm_secret

# --- JWT / security ---
SECRET_KEY=replace_with_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=480
NODE_RED_WEBHOOK_SECRET=replace_webhook_secret
MACHINE_STATUS_PUSH_SECRET=replace_machine_push_secret
# Comma-separated origins, or * for open LAN
CORS_ORIGINS=*

# --- Platform ---
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_PASSWORD=ChangeMe-Platform-2026!

# --- Node-RED ---
NODE_RED_URL=http://127.0.0.1:1880